# Browser Picker -- the Linux build, test and install. The main Makefile
# includes this file on Linux; from an unpacked release (the binary and
# browser-picker.desktop next to this file, no Sources/) run it directly:
#
#   make -f Makefile.linux install
#
#   make                build ./build/browser-picker
#   make test           the shared tests, then the Linux ones
#   make install        browser-picker into $(PREFIX)/bin and its desktop file
#                       into $(PREFIX)/share/applications (default ~/.local)
#   make set-default    run the installed browser-picker --set-default
#   make uninstall      remove both again
#   make check-no-network   what the CI "no network" step checks, for Linux
#
# Variables:
#   PREFIX            install prefix                        (~/.local)
#   DESTDIR           staging root for packaging            (none)
#   LINUX_SWIFTFLAGS  swiftc flags; -static-stdlib links the Swift runtime
#                     and Foundation in, so the binary needs only the C
#                     libraries every distribution has   (-O -static-stdlib)
#
# Plain swiftc, as on macOS: Sources/Core plus Sources/Linux, and a generated
# file with the version (from Resources/Info.plist, the one place it is set)
# and the example config (so --init-config needs no file next to the binary).

BUILD            ?= build
SWIFTC           ?= swiftc
EXAMPLE_CONFIG   ?= config.example.toml
CORE_SOURCES     ?= $(sort $(wildcard Sources/Core/*.swift))
LINUX_SWIFTFLAGS ?= -O -static-stdlib
PREFIX           ?= $(HOME)/.local
BINDIR           := $(PREFIX)/bin
APPDIR           := $(PREFIX)/share/applications
PLIST            := Resources/Info.plist

LINUX_SOURCES    := $(sort $(wildcard Sources/Linux/*.swift))
# Everything but main.swift (top-level code), for the tests.
LINUX_LIB        := $(filter-out Sources/Linux/main.swift,$(LINUX_SOURCES))
GENERATED        := $(BUILD)/Generated.swift

# In an unpacked release there is no source tree: install what is there.
ifeq ($(wildcard Sources/Linux),)
BIN              ?= ./browser-picker
DESKTOP_TEMPLATE ?= browser-picker.desktop
else
BIN              ?= $(BUILD)/browser-picker
DESKTOP_TEMPLATE ?= Resources/linux/browser-picker.desktop
endif

.PHONY: build test test-linux install uninstall set-default check-no-network

build: $(BUILD)/browser-picker

$(GENERATED): $(PLIST) $(EXAMPLE_CONFIG) Makefile.linux
	mkdir -p $(BUILD)
	@v=$$(sed -n '/<key>CFBundleShortVersionString<\/key>/{n;s/.*<string>\(.*\)<\/string>.*/\1/p;}' $(PLIST)); \
	[ -n "$$v" ] || { echo "no CFBundleShortVersionString in $(PLIST)"; exit 1; }; \
	{ printf '// Generated by Makefile.linux from %s and %s; do not edit.\n' $(PLIST) $(EXAMPLE_CONFIG); \
	  printf 'let appVersion = "%s"\n' "$$v"; \
	  printf 'let exampleConfigBase64 = "'; base64 -w0 $(EXAMPLE_CONFIG); printf '"\n'; } > $@.tmp
	mv $@.tmp $@

$(BUILD)/browser-picker: $(CORE_SOURCES) $(LINUX_SOURCES) $(GENERATED)
	$(SWIFTC) $(LINUX_SWIFTFLAGS) -module-name BrowserPicker -o $@.tmp $^
	mv $@.tmp $@
	@echo "built $@"

# Added to the main Makefile's `test` (which runs the shared tests).
test: test-linux

test-linux: $(BUILD)/linux-tests
	$(BUILD)/linux-tests

$(BUILD)/linux-tests: $(CORE_SOURCES) $(LINUX_LIB) Tests/Harness.swift $(sort $(wildcard Tests/Linux*.swift))
	mkdir -p $(BUILD)
	$(SWIFTC) -o $@ $^

# The desktop file's Exec gets the installed path. It is written into the
# file unquoted, so the path is limited to characters that need no quoting
# in an Exec line (browser-picker --set-default quotes any path itself).
install: $(BIN)
	@case "$(BINDIR)" in *[!A-Za-z0-9._/+-]*|"") \
	  echo "PREFIX must be a plain path (letters, digits and . _ / + -): $(PREFIX)"; exit 1;; esac
	install -d "$(DESTDIR)$(BINDIR)" "$(DESTDIR)$(APPDIR)"
	install -m 755 $(BIN) "$(DESTDIR)$(BINDIR)/browser-picker"
	sed 's|@EXEC@|$(BINDIR)/browser-picker|' $(DESKTOP_TEMPLATE) > "$(DESTDIR)$(APPDIR)/browser-picker.desktop.tmp"
	chmod 644 "$(DESTDIR)$(APPDIR)/browser-picker.desktop.tmp"
	mv "$(DESTDIR)$(APPDIR)/browser-picker.desktop.tmp" "$(DESTDIR)$(APPDIR)/browser-picker.desktop"
	-if command -v update-desktop-database >/dev/null 2>&1; then update-desktop-database "$(DESTDIR)$(APPDIR)"; fi
	@echo "installed $(BINDIR)/browser-picker and $(APPDIR)/browser-picker.desktop"
	@echo "Next: make set-default (or browser-picker --set-default), then browser-picker --init-config"

set-default:
	@test -x "$(BINDIR)/browser-picker" || { echo "$(BINDIR)/browser-picker is not installed; run make install first"; exit 1; }
	"$(BINDIR)/browser-picker" --set-default

uninstall:
	rm -f "$(DESTDIR)$(BINDIR)/browser-picker" "$(DESTDIR)$(APPDIR)/browser-picker.desktop"
	-if command -v update-desktop-database >/dev/null 2>&1; then update-desktop-database "$(DESTDIR)$(APPDIR)"; fi
	@echo "removed. Your config in ~/.config/browser-picker is left alone; choose another"
	@echo "default browser (xdg-settings set default-web-browser <browser>.desktop)."

# What can be checked about network code in the Linux binary. With
# -static-stdlib, Foundation is linked in, and Foundation itself has code
# that calls getaddrinfo (its Host class), so the binary's symbol table says
# little about our code. Our own code is checked instead, compiled on its
# own as one object, before Foundation is linked in:
#   1. the binary links no networking library dynamically (curl, ssl,
#      FoundationNetworking): NEEDED holds only the C libraries;
#   2. our object imports no socket, DNS or dynamic-lookup symbols, and
#      nothing from FoundationNetworking (URLSession);
#   3. Sources/Linux imports no networking module and names no helper
#      program outside the list below (browsers come from desktop entries,
#      the menu from [picker] command, both the user's own).
LINUX_TOOLS := notify-send xdg-settings xdg-mime update-desktop-database fuzzel wofi rofi bemenu tofi dmenu

check-no-network: $(BUILD)/browser-picker
	@fail=0; err() { echo "::error::$$*"; fail=1; }; \
	needed=$$(readelf -d $(BUILD)/browser-picker | sed -n 's/.*(NEEDED).*\[\(.*\)\]/\1/p' | sort -u); \
	echo "NEEDED:"; echo "$$needed" | sed 's/^/  /'; \
	bad=$$(echo "$$needed" | grep -vE '^(libc|libm|libdl|libpthread|librt|libutil|libgcc_s|libstdc\+\+|ld-linux[-a-z0-9_.]*)\.so' || true); \
	[ -z "$$bad" ] || err "links an unexpected library: $$(echo $$bad)"; \
	mkdir -p $(BUILD)/obj; \
	$(SWIFTC) -O -wmo -c -module-name BrowserPicker -o $(BUILD)/obj/browser-picker.o \
	  $(CORE_SOURCES) $(LINUX_SOURCES) $(GENERATED) || exit 1; \
	syms=$$(nm -u $(BUILD)/obj/browser-picker.o | awk '{print $$NF}' | sort -u); \
	bad=$$(echo "$$syms" | grep -E \
	  -e '^(socket|connect|bind|listen|accept4?|sendto|sendmsg|recvfrom|recvmsg|getaddrinfo|getnameinfo|gethostbyname2?|gethostbyaddr|res_n?query|dlopen|dlsym|dlmopen)$$' \
	  -e 'FoundationNetworking|URLSession|URLRequest|curl_' || true); \
	[ -z "$$bad" ] || err "our code imports network or dynamic-lookup symbols: $$(echo $$bad)"; \
	bad=$$(grep -rnE '^[[:space:]]*import[[:space:]]+(FoundationNetworking|Network|NIO)' Sources/Linux || true); \
	[ -z "$$bad" ] || err "imports a networking module: $$bad"; \
	tools=$$( { grep -rhoE 'Spawn\.(capture|detached|which)\(\[?"[^"]+"' Sources/Linux | sed -E 's/.*"([^"]+)"$$/\1/'; \
	            sed -n 's/^ *case \(fuzzel.*\)$$/\1/p' Sources/Linux/Menu.swift | tr -d ' ' | tr ',' '\n'; } | sort -u); \
	echo "Programs Sources/Linux runs by name:"; echo "$$tools" | sed 's/^/  /'; \
	for t in $$tools; do case " $(LINUX_TOOLS) " in *" $$t "*) ;; *) err "runs an unexpected program: $$t";; esac; done; \
	[ "$$fail" = 0 ] && echo "no network code found"; exit $$fail
